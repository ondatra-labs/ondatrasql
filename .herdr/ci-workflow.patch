diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index bd5fad3..10893d8 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -63,6 +63,48 @@ jobs:
           CC: gcc
         run: go test -p 1 -race -timeout 30m -tags "integration e2e" ./...
 
+  # Blueprints (blueprints/README.md), offline and without secrets: each
+  # one is checked with the binary built from this checkout and with the
+  # latest GitHub release. A blueprint whose min_version is above that
+  # release is reported as tested against main only. The recordings are
+  # private, so each replay is reported as skipped.
+  blueprints:
+    name: Blueprints (linux)
+    runs-on: ubuntu-latest
+
+    steps:
+      - uses: actions/checkout@v5
+
+      - uses: actions/setup-go@v6
+        with:
+          go-version-file: go.mod
+
+      - name: Test blueprints (built from this checkout)
+        shell: bash
+        env:
+          CGO_ENABLED: 1
+          CC: gcc
+        run: make test-blueprints
+
+      - name: Download the latest release
+        shell: bash
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          dir="$RUNNER_TEMP/ondatrasql-release"
+          gh release view --repo "$GITHUB_REPOSITORY" --json tagName,publishedAt
+          gh release download --repo "$GITHUB_REPOSITORY" --dir "$dir" \
+            --pattern 'ondatrasql_*_linux_amd64.tar.gz' --pattern checksums.txt
+          cd "$dir"
+          sha256sum --check --ignore-missing checksums.txt
+          tar xzf ondatrasql_*_linux_amd64.tar.gz
+          ./ondatrasql version
+          echo "RELEASED_BIN=$dir/ondatrasql" >> "$GITHUB_ENV"
+
+      - name: Test blueprints (latest release)
+        shell: bash
+        run: make test-blueprints-bin ONDATRASQL_BIN="$RELEASED_BIN"
+
   # ----------------------------------------------------------------------
   # Release jobs — only run on tag pushes (v*) and ONLY after every test
   # job above has succeeded. Building binaries and publishing a release
