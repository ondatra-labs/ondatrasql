# Path to the JSON key file of a Google Cloud service account that is a user
# of the Search Console property (Settings > Users and permissions); see
# index.md.
GOOGLE_SEARCH_CONSOLE_KEY_FILE=
# The property, used when a model gives none: sc-domain:example.com for a
# domain property, https://www.example.com/ for a URL prefix property.
GOOGLE_SEARCH_CONSOLE_SITE=
