# Your Toggl Track API token: Profile settings (click your avatar, then
# Profile settings), API Token at the bottom of the page. Sent as the user of
# basic auth, with the password api_token.
TOGGL_API_TOKEN=
# The workspace id: open Reports in Toggl Track, it is the number in the URL
# (track.toggl.com/reports/summary/<workspace id>). Used when a model gives
# none.
TOGGL_WORKSPACE_ID=
